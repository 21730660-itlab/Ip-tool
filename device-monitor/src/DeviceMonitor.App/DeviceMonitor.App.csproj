<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeviceMonitor.App</RootNamespace>
    <AssemblyName>Device-Monitor</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Device Monitor</Product>
    <Version>1.2.0</Version>
    <Company>Device Monitor</Company>
    <Description>Device Monitor - ping monitoring for MikroTik and other network devices</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF without XAML compilation: the windows are built in code, so the plain .NET SDK can build this on any OS.
         Windows Forms is only used for the notification-area (tray) icon. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="..\DeviceMonitor.Core\DeviceMonitor.Core.csproj" />
  </ItemGroup>
</Project>
