<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IpMonitor.App</RootNamespace>
    <AssemblyName>IP-Monitor</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>IP Monitor</Product>
    <Version>1.4.0</Version>
    <Company>IP Monitor</Company>
    <Description>IP Monitor for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF without XAML compilation: the windows are built in code, so the plain .NET SDK can build this on any OS -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="..\IpMonitor.Core\IpMonitor.Core.csproj" />
  </ItemGroup>
</Project>
